include README.md LICENSE SECURITY.md THIRD_PARTY_NOTICES.md pyproject.toml
recursive-include docs *.md
include docs/REAL_EVALUATION_RECEIPT.json
include configs/fixture_manifest.json
include configs/bdd100k_detection_v1.json
include configs/bdd100k_segmentation_v1.json
include configs/bdd100k_tracking_v1.json
include configs/local_evaluation_template.json
recursive-include scripts *.py
include data/raw/README.md
include data/registry/bdd100k_v1.json

# Keep generated editable-checkout metadata out of the normal source list.
# Setuptools may still retain a minimal SOURCES.txt index while rebuilding the
# sdist; it contains only relative filenames and no local data or credentials.
prune src/roadsense_perception.egg-info
exclude src/roadsense_perception.egg-info/*
